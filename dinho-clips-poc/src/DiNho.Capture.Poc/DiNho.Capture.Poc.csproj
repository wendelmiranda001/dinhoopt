<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Esta fase é Windows-only por natureza: DXGI e WGC não existem em outras plataformas. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>DiNho.Capture.Poc</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Necessário para usar a projeção do Windows.Graphics.Capture via CsWinRT -->
    <UseWinUI>false</UseWinUI>
    <!-- .NET 10 projections Windows.Graphics.Capture and Direct3D11 natively — no CsWinRT needed -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Bindings de DXGI / Direct3D11 / D3D11 device, sem precisar escrever P/Invoke manual para tudo -->
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />

    <!-- .NET 10 projects Windows.Graphics.Capture and Direct3D11 natively — CsWinRT package no longer needed -->

    <!-- Media Foundation (encoder MFT + Sink Writer) -->
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />

    <!-- CsWin32 source generator — auto-generated P/Invoke bindings -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- WASAPI audio capture -->
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="games.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ApplicationLoopback.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiNho.Capture.Poc.Tests" />
  </ItemGroup>

</Project>
