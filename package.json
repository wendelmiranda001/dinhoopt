{
  "name": "dinho-optimizer",
  "version": "2.1.0",
  "description": "DiNho Optimizer — Otimizador de sistema Windows",
  "repository": "optdinho/optdinho",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run copy-engine && electron-vite build && electron-builder --win",
    "publish": "npm run copy-engine && electron-vite build && electron-builder --win --publish always",
    "copy-engine": "node scripts/copy-engine.js",
    "build:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ffmpeg.ps1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.cjs",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "clean": "node -e \"const{f}=require('fs');['out','dist','coverage'].forEach(d=>f.rmSync(d,{recursive:true,force:true}))\"",
    "audit": "npm audit --audit-level=high",
    "validate:rules": "npx tsx src/main/rules/validate.ts",
    "new-rule": "node scripts/new-rule.js",
    "find-cache": "node scripts/find-cache.js",
    "preview-rule": "node scripts/preview-rule.js",
    "postinstall": "patch-package"
  },
  "keywords": [
    "system-cleaner",
    "electron",
    "windows",
    "optimization"
  ],
  "author": {
    "name": "DiNho",
    "email": "contato@dinhooptimizer.com"
  },
  "license": "Commercial",
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^6.0.0-beta.1",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@litko/yara-x": "^0.7.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.2.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.45.0",
    "node-machine-id": "^1.1.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "systeminformation": "^5.33.10",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "engines": {
    "node": ">=22.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
